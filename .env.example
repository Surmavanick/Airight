# Copy to .env if you need non-default settings. It is ignored by git and never served.

# Console access key. Optional only for a fully local/offline setup; required by
# hosted APIs and whenever a paid external provider key is configured locally.
ADMIN_PASSWORD=

PORT=8000

# External detector. The Vercel API uses it for text, images and sampled video frames.
# Hosted voice detection is opt-in because it is not enabled on every AI or Not plan.
# Set AIORNOT_AUDIO_ENABLED=true only after the provider confirms ai_voice access.
# The local launcher always uses Spectra-AASIST3 for speech and this flag does not affect it.
# Both credentials stay server-side and are never returned to the browser or evidence export.
AIORNOT_API_KEY=
# Optional second credential. The primary above is still required. This is used
# once only after provider HTTP 401, 402, or 403; it is not a general retry for
# rate limits, timeouts, network errors, invalid input, or provider 5xx errors.
AIORNOT_API_KEY_BACKUP=
AIORNOT_AUDIO_ENABLED=false
AIORNOT_TIMEOUT_MS=120000
# These guards count outbound provider attempts. One credential failover uses two attempts.
AIORNOT_MAX_REQUESTS_PER_MINUTE=12
AIORNOT_MAX_CONCURRENT=2

# Optional server-side token for importing public GitHub repositories. Without it,
# GitHub allows 60 unauthenticated REST requests/hour per deployment egress IP;
# a fine-grained token with public Metadata/Contents read raises the normal limit.
GITHUB_API_TOKEN=

# Optional Evidence Copilot. This produces editable plans and evidence drafts;
# it does not replace detector scores or prove authorship. Only bounded report
# metadata is sent; attachment bytes stay in the browser. The response is made
# with store=false so it is not retained as a retrievable Responses API object.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_REQUESTS_PER_MINUTE=8
OPENAI_MAX_CONCURRENT=1

# Only applies when AIORNOT_API_KEY is empty. Paid provider mode always requires
# the same-origin http://127.0.0.1:PORT console and rejects file:// Origin:null.
ALLOW_FILE_ORIGIN_CORS=false

# Optional absolute path to Python when the project virtual environment is not used.
PYTHON=

# Maximum time for one detector request, in milliseconds.
ML_TIMEOUT_MS=600000
