# Copy to .env if you need non-default settings. It is ignored by git and never served.

# Console access key. Optional for localhost-only use; required by the hosted Vercel API.
ADMIN_PASSWORD=

PORT=8000

# External detector. The Vercel API uses it for text, images, sampled video frames,
# and voice audio. The local launcher uses it for image/frame comparison only.
# The key stays server-side and is never returned to the browser or evidence export.
AIORNOT_API_KEY=
AIORNOT_TIMEOUT_MS=120000
AIORNOT_MAX_REQUESTS_PER_MINUTE=12
AIORNOT_MAX_CONCURRENT=2

# Only applies when AIORNOT_API_KEY is empty. Paid provider mode always requires
# the same-origin http://127.0.0.1:PORT console and rejects file:// Origin:null.
ALLOW_FILE_ORIGIN_CORS=false

# Optional absolute path to Python when the project virtual environment is not used.
PYTHON=

# Maximum time for one detector request, in milliseconds.
ML_TIMEOUT_MS=600000
